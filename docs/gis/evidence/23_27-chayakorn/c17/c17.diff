+-- 053 rolled-back lifecycle (caller: BEGIN; migration; ledger; this; ROLLBACK).
+-- Settings t.actor (officer), t.worker (another profile), t.province come from the caller.
+-- A report may name the 41-province asset (053), the 24-province asset (051) or the GADM asset (034).
+SET LOCAL ROLE gis_owner;
+DO $t$ DECLARE a uuid:=current_setting('t.actor')::uuid; w uuid:=current_setting('t.worker')::uuid; p text:=current_setting('t.province');
+ ds jsonb; up jsonb; job jsonb; ok jsonb; bad jsonb; r jsonb; failed boolean; sha text:=repeat('e',64); h text;
+ gadm text:='ac2b28255f22861ab644bf083fa40f28dd9da1294648d4b01cfc6f9cdc156a21';
+ ldd24 text:='1b6cf62b8f43504078c51c9ca3e94f6fffe56c2ca1b3765674d5aa2d7c62e1ac';
+ ldd41 text:='49473e7e59aeecfe4b3dff1c9b6ebc21ffe859fa76de47c46c45e1d55dae93a3';
+ ed gis.editions; jb gis.jobs; role_name text;
+BEGIN
+ ds:=gis.command(a,'dddddddd-0530-4000-8000-000000000001','create_dataset',jsonb_build_object('province',p,'data_year',2011,'month',0,'kind','ldd_shapefile','purpose','landuse','title','t053-ldd'),false)->'body';
+ up:=gis.ldd_command(a,'dddddddd-0530-4000-8000-000000000002','upload',jsonb_build_object('dataset_id',ds->>'id','expected_revision',ds->'revision','upload_id','dddddddd-0530-4000-8000-0000000000a1','sha256',sha,'byte_size',10,'crs','EPSG:32647','encoding','utf-8','source_label','t053'),false);
+ PERFORM gis.ldd_command(a,'dddddddd-0530-4000-8000-000000000003','enqueue',jsonb_build_object('edition_id',up->'body'->>'edition_id','expected_revision',1),false);
+ job:=gis.queue_protocol_kind('claim',jsonb_build_object('worker_id',w),'ldd')->'job';
+ IF job->>'upload_id'<>up->'body'->>'upload_id' THEN RAISE EXCEPTION 'T_CLAIM %',job; END IF;
+ SELECT * INTO ed FROM gis.editions WHERE id=(up->'body'->>'edition_id')::uuid;
+ SELECT * INTO jb FROM gis.jobs WHERE id=(job->>'id')::uuid;
+ -- An accepted report, the shape a real validation produces.
+ ok:=jsonb_build_object('schema_version',1,'provider_build','ldd-local-v1','upload_id',job->>'upload_id','artifact_sha256',sha,'observed_sha256',sha,'byte_size',10,
+   'input_hash',job->>'input_hash','input_revision',job->'input_revision','province',p,'data_year',2011,'crs','EPSG:32647','encoding','utf-8','valid',true,
+   'checks','["source_hash_match","archive_safety","components","crs","geometry","attributes","encoding","ldd_codes","province_bounds","dataset_association"]'::jsonb,
+   'errors','[]'::jsonb,'warnings','[{"code":"BOUNDARY_FROM_DATA_PRODUCER","count":1},{"code":"DATA_YEAR_METADATA_DECLARED","count":1}]'::jsonb,'error_code',NULL::text,
+   'boundary_sha256',ldd41,
+   'statistics','{"feature_count":3,"total_area_m2":100,"unknown_area_m2":0,"unknown_code_count":0,"composite_feature_count":0,"geometry_error_count":0,"area_by_main_m2":{"U":100,"A":0,"F":0,"W":0,"M":0}}'::jsonb);
+ -- The three known assets pass; the 049/050 layers underneath still run (an audit is checked with the new hash).
+ FOREACH h IN ARRAY ARRAY[ldd41,ldd24,gadm] LOOP
+   PERFORM gis.validate_ldd_report(jsonb_set(ok,'{boundary_sha256}',to_jsonb(h)),ed,jb);
+ END LOOP;
+ PERFORM gis.validate_ldd_report(ok||jsonb_build_object('audit','{"policy_version":"ldd-policy-v2","outcome":"accepted","field_profile":"ldd-lu-text-v1","field_mapping":{"main_code":"LUL1_CODE","lu_code":"LU_CODE","declared_area":"Shape_Area"},"declared_area_units":"m2","feature_outcomes":{"accepted":3,"accepted_with_warnings":0,"review_required":0,"rejected":0},"boundary":{"minor":0,"review":0,"fatal":0,"outside_area_m2":0},"unknown_samples":[],"repairs":[],"repairs_total":0}'::jsonb),ed,jb);
+ -- Nothing else is accepted: another hash, a near miss of the new one, a wrong type, a missing key.
+ FOR bad IN SELECT x FROM unnest(ARRAY[
+   jsonb_set(ok,'{boundary_sha256}',to_jsonb(repeat('0',64))), jsonb_set(ok,'{boundary_sha256}',to_jsonb(upper(ldd41))),
+   jsonb_set(ok,'{boundary_sha256}',to_jsonb(ldd41||'0')), jsonb_set(ok,'{boundary_sha256}',to_jsonb(left(ldd41,63))),
+   jsonb_set(ok,'{boundary_sha256}',to_jsonb(upper(ldd24))),
+   jsonb_set(ok,'{boundary_sha256}','null'::jsonb), jsonb_set(ok,'{boundary_sha256}','42'::jsonb), ok-'boundary_sha256']) x LOOP
+   failed:=false;
+   BEGIN PERFORM gis.validate_ldd_report(bad,ed,jb);
+   EXCEPTION WHEN raise_exception THEN failed:=SQLERRM LIKE 'GIS_%'; END;
+   IF NOT failed THEN RAISE EXCEPTION 'T_BAD_BOUNDARY_HASH_ACCEPTED %',bad->'boundary_sha256'; END IF;
+ END LOOP;
+ -- Every other rule still holds with the new hash.
+ FOR bad IN SELECT x FROM unnest(ARRAY[
+   jsonb_set(ok,'{upload_id}','"dddddddd-0530-4000-8000-0000000000ff"'),
+   jsonb_set(ok,'{province}','"Not A Province"'),
+   jsonb_set(ok,'{observed_sha256}',to_jsonb(repeat('f',64))),
+   ok||'{"extra":1}'::jsonb,
+   jsonb_set(ok,'{statistics,unknown_code_count}','1'),
+   jsonb_set(ok,'{checks}','["source_hash_match"]'),
+   ok||jsonb_build_object('audit','{"outcome":"accepted"}'::jsonb)]) x LOOP
+   failed:=false;
+   BEGIN PERFORM gis.validate_ldd_report(bad,ed,jb);
+   EXCEPTION WHEN raise_exception THEN failed:=SQLERRM LIKE 'GIS_%'; END;
+   IF NOT failed THEN RAISE EXCEPTION 'T_OTHER_RULE_NOT_ENFORCED %',left(bad::text,200); END IF;
+ END LOOP;
+ -- A non-object report is still refused by the previous function, not by a type error of the wrapper.
+ failed:=false;
+ BEGIN PERFORM gis.validate_ldd_report('"text"'::jsonb,ed,jb); EXCEPTION WHEN raise_exception THEN failed:=SQLERRM LIKE 'GIS_%'; END;
+ IF NOT failed THEN RAISE EXCEPTION 'T_NON_OBJECT_ACCEPTED'; END IF;
+ -- The queue stores the accepted report with the hash it carried, not the one the previous function saw.
+ r:=gis.queue_protocol_kind('complete',jsonb_build_object('job_id',job->>'id','worker_id',w,'lease_token',job->>'lease_token','report',ok),'ldd');
+ IF r->>'state' IS DISTINCT FROM 'succeeded' THEN RAISE EXCEPTION 'T_COMPLETE_STATE %',r; END IF;
+ IF (SELECT validation_report->>'boundary_sha256' FROM gis.attempts WHERE job_id=(job->>'id')::uuid)<>ldd41 THEN RAISE EXCEPTION 'T_STORED_HASH_CHANGED'; END IF;
+ -- The functions stay closed to every API and worker role, the 051 one underneath included.
+ FOR role_name IN SELECT unnest(ARRAY['anon','authenticated','service_role','gis_worker','gis_native_worker']) LOOP
+   IF has_function_privilege(role_name,'gis.validate_ldd_report(jsonb,gis.editions,gis.jobs)','EXECUTE')
+     OR has_function_privilege(role_name,'gis.u053_previous_validate_ldd_report(jsonb,gis.editions,gis.jobs)','EXECUTE')
+     OR has_function_privilege(role_name,'gis.u051_previous_validate_ldd_report(jsonb,gis.editions,gis.jobs)','EXECUTE') THEN
+     RAISE EXCEPTION 'T_VALIDATOR_REACHABLE_BY %',role_name; END IF;
+ END LOOP;
+END $t$;
+RESET ROLE;
diff --git a/dev/gis_local/upload_053_local.py b/dev/gis_local/upload_053_local.py
new file mode 100644
index 0000000..dd54ccc
--- /dev/null
+++ b/dev/gis_local/upload_053_local.py
@@ -0,0 +1,93 @@
+"""Operator for migration 053 (LDD validation accepts the 41-province boundary asset) on the local T0.
+
+  probe    053 + rolled-back lifecycle on both local databases; the ledger stays at 52.
+  migrate  053 for real, only after a matching probe and an approval file you write.
+  proof    read-only ledger and gate check.
+
+Uses the attested local operator from gee_dashboard_local for runtime proof and SQL
+transport. Nothing here reaches Google or Cloud. Output: <runtime root>/upload-053/.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import logging
+from pathlib import Path
+import sys
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('upload_053_dashboard', HERE / 'gee_dashboard_local.py')
+d = importlib.util.module_from_spec(spec); sys.modules[spec.name] = d; spec.loader.exec_module(d)
+MIGRATION = d.REPO / 'green-area-backend/migrations/053_gis_ldd_boundary_asset_v2.sql'
+LIFECYCLE = HERE / 'upload_053_lifecycle.sql'
+APPROVAL = 'local_apply_053_after_rollback_probe'
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+class BoundaryV2Local(d.DashboardLocal):
+    def __init__(self, root):
+        super().__init__(root)
+        self.output = self.db.runtime.root / 'upload-053'
+        self.output.mkdir(exist_ok=True)
+
+    def run_053(self, *, probe):
+        self.proof(allow=(52,) if probe else (52, 53))
+        sha = digest(MIGRATION)
+        q = d._t1().literal
+        prior = {db: self.sql('SELECT to_jsonb(sha256) FROM gis.schema_migrations WHERE version=53', db, read_only=True)
+            for db in d.DATABASES}
+        if any(old is not None and old != sha for old in prior.values()):
+            raise RuntimeError('APPLIED_CHECKSUM_DRIFT_FORWARD_MIGRATION_REQUIRED')
+        results = {}
+        for db, old in prior.items():
+            if old is not None:
+                results[db] = 'already_applied'
+                continue
+            self.db.proof(db, stage='gis')
+            body = "BEGIN;SET LOCAL lock_timeout='5s';SET LOCAL statement_timeout='60s';"
+            body += "SELECT set_config('gis.runtime_instance'," + q(self.db.instance) + ",true);"
+            body += "SELECT set_config('gis.baseline_fingerprint'," + q(d._t1().legacy_fingerprint()) + ",true);"
+            body += MIGRATION.read_text(encoding='utf-8')
+            body += "\nSET LOCAL ROLE gis_owner;INSERT INTO gis.schema_migrations(version,sha256) VALUES(53," + q(sha) + ");RESET ROLE;"
+            if probe:
+                body += self._prelude(db) + LIFECYCLE.read_text(encoding='utf-8') + "\nSET CONSTRAINTS ALL IMMEDIATE;ROLLBACK;"
+            else:
+                body += "COMMIT;"
+            self.db.transport(db, body)
+            results[db] = 'rolled_back_lifecycle' if probe else 'applied'
+        record = {'sha256': sha, 'lifecycle_sha256': digest(LIFECYCLE), 'runtime_instance': self.db.instance, 'databases': results}
+        (self.output / ('probe.json' if probe else 'migration-053.json')).write_text(json.dumps(record, indent=2), encoding='utf-8')
+        return record
+
+    def migrate_053(self, approval):
+        sha = digest(MIGRATION)
+        value = json.loads(Path(approval).read_text(encoding='utf-8'))
+        if value != {'approval': APPROVAL, 'migration_sha256': sha}:
+            raise RuntimeError('MIGRATION_053_APPROVAL_REQUIRED')
+        probe = json.loads((self.output / 'probe.json').read_text(encoding='utf-8'))
+        if (probe.get('sha256') != sha or probe.get('lifecycle_sha256') != digest(LIFECYCLE)
+                or probe.get('runtime_instance') != self.db.instance
+                or probe.get('databases') != {db: 'rolled_back_lifecycle' for db in d.DATABASES}):
+            raise RuntimeError('MIGRATION_053_PROBE_REQUIRED')
+        return self.run_053(probe=False)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=('proof', 'probe', 'migrate'))
+    parser.add_argument('--runtime-dir', type=Path, required=True)
+    parser.add_argument('--approval', type=Path)
+    args = parser.parse_args()
+    for name in ('httpx', 'httpcore', 'postgrest', 'supabase_auth', 'gotrue'):
+        logging.getLogger(name).setLevel(logging.CRITICAL)
+    local = BoundaryV2Local(args.runtime_dir)
+    if args.action == 'proof':
+        value = local.proof(allow=(52, 53))
+    elif args.action == 'probe':
+        value = local.run_053(probe=True)
+    else:
+        value = local.migrate_053(args.approval)
+    print(json.dumps(value))
diff --git a/docs/gis/ldd-field-policy.md b/docs/gis/ldd-field-policy.md
index 445943d..9948eea 100644
--- a/docs/gis/ldd-field-policy.md
+++ b/docs/gis/ldd-field-policy.md
@@ -77,7 +77,7 @@ Policy-v2 validation tolerates two variants written by the producer's software.
 
 Boundary source (`province_boundaries_ldd.json`, `ldd-boundaries-v1`, rebuilt with `dev/gis_local/run_build_ldd_boundaries.ps1`):
 
-- For the 24 provinces whose LDD package carries a province layer (`*_Pro.shp` or `prov_*.shp`) the validator reads that layer (`source: ldd-package`). It is snapped to 1e-8° (about 1 mm) and records the SHA256 of the package and of the layer it came from. The other 53 provinces keep the approximate GADM outline, byte for byte (`source: gadm-approx`). Ang Thong and Lop Buri have packages but no province layer, so they stay on GADM.
+- For the 41 provinces whose LDD package carries a province layer (`*_Pro.shp` or `prov_*.shp`) the validator reads that layer (`source: ldd-package`). It is snapped to 1e-8° (about 1 mm) and records the SHA256 of the package and of the layer it came from. The other 36 provinces keep the approximate GADM outline, byte for byte (`source: gadm-approx`). Ang Thong and Lop Buri have packages but no province layer, so they stay on GADM.
 - Packages were matched to provinces by overlap with the GADM outline (IoU 0.93 to 0.99), never by file name. Each layer was checked against its own land-use layer (1,059,852 parcels in all, including provinces too large for the validator's current limits): none lies more than 225 m outside it, 1.8 % touch the line within that tolerance, and the area outside is at most 0.007 % of a province (Sing Buri), usually under 0.00002 %.
 - The report names the asset it read (`boundary_sha256`) and says which kind of outline it was: the warning `BOUNDARY_FROM_DATA_PRODUCER` or `BOUNDARY_APPROXIMATE`. The producer's outline is not an independent source; it is the line the producer clipped its own parcels to.
 - The frozen pre-v2 validator, the v1 preparation and GeoTIFF clipping still read the GADM asset (`province_boundaries.json`, hash unchanged).
