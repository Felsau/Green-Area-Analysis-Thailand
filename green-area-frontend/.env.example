# Local dev env — copy to .env.local (gitignored) and fill in real values.
# Vite only exposes vars prefixed VITE_ to client code.

# Backend URL — default http://localhost:8000 if unset
# VITE_API_URL=http://localhost:8000

# Supabase project (Settings → API in the Supabase dashboard).
# ANON_KEY is the public "anon"/"publishable" key — safe to ship to the
# browser (Row Level Security controls what it can actually do). The
# service-role key stays backend-only (green-area-backend/.env SUPABASE_KEY).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Required one-time Supabase Dashboard setup for the login system to work:
#   1. Run green-area-backend/migrations/010_create_profiles.sql, 011_profiles_consent_and_updated_at.sql,
#      and 012_profiles_organization.sql (in order) in the SQL Editor.
#   2. Authentication → Providers → Email: enable "Confirm email".
#   3. Authentication → Email Templates → "Confirm signup": the default template
#      is a magic link — replace it with one that surfaces {{ .Token }} (the
#      6-digit OTP) since the app's verify-email screen expects a code, e.g.:
#        <p>Your GreenLens verification code is: {{ .Token }}</p>
#   4. Authentication → URL Configuration → Site URL / Redirect URLs: add this
#      app's URL (http://localhost:3000 for dev) so password-reset links
#      redirect back here correctly.
